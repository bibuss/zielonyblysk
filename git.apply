tion:none}.blog-meta{display:block;margin-top:1rem;font-size:.85rem;color:var(--muted)}.blog-cta{margin-top:2.5rem;text-align:center}.features h2,.seo-intro h2,.service-areas h2,.testimonials h2,.pricing h2,.faq h2,.contact h2,.legal h2{text-align:center;font-size:clamp(2rem,3vw,2.6rem);margin-bottom:1.2rem}.section-lead{text-align:center;color:var(--muted);max-width:640px;margin:.5rem auto 3rem}.seo-intro{background:linear-gradient(180deg,rgba(0,208,122,0.08),rgba(247,249,251,0.8))}.seo-intro .content-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;align-items:start}.seo-intro p{color:var(--muted)}.seo-intro ul{list-style:none;display:grid;gap:.75rem;margin-top:1.5rem}.seo-intro ul li{position:relative;padding-left:1.5rem;color:var(--muted)}.seo-intro ul li::before{content:'✓';position:absolute;left:0;top:0;color:var(--gradient-end);font-weight:600}.seo-intro aside{background:var(--white);padding:2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:grid;gap:1.4rem}.seo-intro dl{display:grid;gap:1.2rem}.seo-intro dt{font-weight:600;color:var(--gradient-end)}.seo-intro dd{margin:.25rem 0 0;color:var(--muted)}.service-areas{background:radial-gradient(circle at top right,rgba(0,208,122,0.12),transparent 45%),var(--bg)}.service-areas .area-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.8rem;margin-top:3rem}.area-card{background:var(--white);padding:2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:grid;gap:1rem}.area-card h3{font-size:1.3rem}.area-card p{color:var(--muted)}.common-requests{background:linear-gradient(180deg,rgba(26,195,91,0.08),rgba(247,249,251,1))}.common-requests .section-lead{max-width:720px;margin:1rem auto 0;text-align:center;color:var(--muted)}.request-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.6rem;margin-top:3rem}.request-card{background:var(--white);padding:1.8rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:grid;gap:1rem}.request-card h3{font-size:1.2rem}.request-card p{color:var(--muted)}.request-card .btn-link{font-weight:600;color:var(--gradient-end);text-decoration:none;display:inline-flex;align-items:center;gap:.4rem}.request-card .btn-link::after{content:'→';transition:transform .2s ease}.request-card .btn-link:hover::after,.request-card .btn-link:focus-visible::after{transform:translateX(4px)}.faq{background:var(--white)}.faq-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.8rem;margin-top:2.5rem}.faq-item{background:var(--white);border-radius:var(--radius-md);box-shadow:var(--card-shadow);padding:2rem;display:grid;gap:1rem}.faq-item h3{font-size:1.2rem}.faq-item p{color:var(--muted)}.legal-page{padding:6rem 0}.legal-page h1{text-align:center;font-size:clamp(2.2rem,3.5vw,2.8rem);margin-bottom:1rem}.legal-page .section-lead{margin-bottom:2.5rem}.legal-page .legal-grid{display:grid;gap:1.6rem}.legal-page .legal-grid article{background:var(--white);padding:2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:grid;gap:1rem}.legal-page h2{text-align:left;font-size:clamp(1.6rem,2.6vw,2rem)}.legal-page p,.legal-page li{color:var(--muted)}.legal-page ul{list-style:disc;padding-left:1.5rem;display:grid;gap:.5rem}.back-link{display:inline-flex;align-items:center;gap:.4rem;margin-top:2.5rem;color:var(--gradient-end);text-decoration:none;font-weight:600}.back-link:hover{text-decoration:underline}.subpage-hero{min-height:auto;padding:2rem 0 0}.subpage-hero .hero-content{grid-template-columns:1fr;padding-bottom:2rem}.subpage-hero .hero-text{padding-top:2rem}.subpage-hero .hero-card{display:none}.article{padding:2rem 0 4rem}.article .container{display:flex;flex-direction:column;gap:1.5rem;font-size:1.05rem;line-height:1.8}.article section{background:var(--white);padding:1.5rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow)}.article section h2{margin-top:0;font-size:1.4rem}.article .article-tip{border-left:4px solid var(--gradient-end)}.article .article-tip a{color:var(--gradient-end);font-weight:600}.article .article-cta{border-left:4px solid var(--gradient-start);background:linear-gradient(180deg,rgba(26,195,91,0.08),rgba(255,255,255,0.95))}.article .article-cta a{color:var(--gradient-end);font-weight:600}.article .article-links{margin-top:1.2rem;display:flex;flex-wrap:wrap;gap:.75rem}.article .article-links a{display:inline-flex;align-items:center;gap:.3rem;padding:.6rem 1rem;border-radius:var(--radius-sm);background:rgba(13,114,60,0.08)}.breadcrumb{font-size:.9rem;color:var(--muted);margin-bottom:.75rem}.breadcrumb a{color:inherit;text-decoration:none}.breadcrumb a:hover{text-decoration:underline}.feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.8rem}.feature-card{background:var(--white);padding:2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:flex;flex-direction:column;gap:1rem}.icon-circle{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,rgba(0,208,122,0.18),rgba(25,169,96,0.34));display:grid;place-items:center;color:var(--gradient-end);font-size:1.6rem}.material-icon{font-family:'Material Symbols Outlined',sans-serif;font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;display:inline-flex;align-items:center;justify-content:center;line-height:1}.testimonial-slider{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.8rem;margin-top:2.5rem}.testimonial-card{background:var(--white);padding:2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:flex;flex-direction:column;gap:1.5rem;transition:transform .3s ease,box-shadow .3s ease}.testimonial-card p{font-style:italic;color:var(--muted)}.testimonial-card.active{transform:translateY(-6px);box-shadow:0 30px 70px rgba(15,69,34,0.18)}.testimonial-author{display:flex;align-items:center;gap:1rem}.avatar{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--gradient-start),var(--gradient-end));color:var(--white);font-weight:600}.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:2rem;margin-top:3rem}.pricing-card{background:var(--white);padding:2.4rem 2rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:flex;flex-direction:column;gap:1.5rem;position:relative}.pricing-card.highlight{transform:translateY(-10px);border:1px solid rgba(0,208,122,0.3)}.price{font-size:2.4rem;font-weight:700;color:var(--gradient-end)}.price span{font-size:1rem;font-weight:500;color:var(--muted);margin-right:.4rem}.pricing-card ul{list-style:none;display:grid;gap:.75rem;color:var(--muted)}.pricing-card ul li::before{content:'•';color:var(--gradient-end);margin-right:.5rem}.contact .container{display:grid;gap:3rem;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));align-items:start}.contact-intro p{color:var(--muted);margin-bottom:2rem}.contact-details{display:grid;gap:1rem}.contact-link{display:inline-flex;align-items:center;gap:.75rem;color:var(--text);text-decoration:none;font-weight:500;padding:.6rem 1rem;border-radius:var(--radius-sm);background:rgba(13,114,60,0.08);width:fit-content}.contact-link .material-icon{font-size:1.3rem}.contact-form{background:var(--white);padding:2.5rem;border-radius:var(--radius-md);box-shadow:var(--card-shadow);display:grid;gap:1.2rem}.legal-grid{margin-top:2.5rem;display:grid;gap:1.75rem;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}.legal-grid article{background:var(--white);border-radius:var(--radius-md);box-shadow:0 20px 40px rgba(15,69,34,0.08);padding:1.75rem;display:flex;flex-direction:column;gap:.75rem}.legal-grid h3{font-size:1.1rem;color:var(--text)}.legal-grid p{color:var(--muted)}.legal a{color:var(--gradient-end);font-weight:500}.floating-call{position:fixed;bottom:24px;right:24px;display:none;align-items:center;gap:.6rem;background:linear-gradient(135deg,var(--gradient-start),var(--gradient-end));color:var(--white);text-decoration:none;padding:.85rem 1.4rem;border-radius:999px;box-shadow:0 20px 40px rgba(10,137,65,0.35);font-weight:600;z-index:999}.floating-call .material-icon{font-size:1.25rem}.footer{background:#0b3d2a;color:var(--white);padding:2.5rem 0}.footer-content{display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap}.footer .brand-title{color:var(--white)}.footer .brand-subtitle{color:rgba(255,255,255,0.6)}.footer-links{display:flex;gap:1.5rem}.footer-links a{color:rgba(255,255,255,0.7);text-decoration:none;font-size:.9rem}.footer-links a:hover{color:var(--white)}@media(max-width:960px){.hero-content{grid-template-columns:1fr;padding-bottom:3rem}.hero-text{padding-top:3rem}.hero-card{justify-content:flex-start}.card{max-width:420px}.hero-stats{grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}}@media(max-width:768px){.nav{padding:1.4rem 0 1rem}.nav-toggle{display:flex}.nav-links{position:absolute;top:100%;right:0;flex-direction:column;background:rgba(255,255,255,0.95);border-radius:var(--radius-md);padding:1.4rem;gap:1rem;box-shadow:var(--card-shadow);transform:translateY(-10px);opacity:0;pointer-events:none;transition:opacity .3s ease,transform .3s ease}.nav-links.open{opacity:1;transform:translateY(10px);pointer-events:auto}.nav-links a{font-size:1rem}.hero-actions{flex-direction:column;width:100%}.trust-badges{flex-direction:column}.floating-call{display:inline-flex}}@media(max-width:600px){.hero{min-height:auto}.nav{width:92vw}.hero-content{width:92vw}.btn{width:100%}.hero-stats{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}.showcase-grid,.process-steps,.service-areas .area-grid,.calculator,.map-grid,.blog-grid,.seo-intro .content-grid,.faq-list{grid-template-columns:1fr}.service-links{flex-direction:column;align-items:flex-start}.seo-intro aside{padding:1.6rem}.legal-page .legal-grid{grid-template-columns:1fr}.footer-content{flex-direction:column;align-